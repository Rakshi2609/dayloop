<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sensors (no permission needed for SensorManager). -->
    <!-- Microphone for on-device Whisper ASR. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- IR blaster (no permission, but feature is optional). -->
    <uses-feature android:name="android.hardware-consumerir" android:required="false" />
    <!-- Vibrator (no permission). -->
    <!-- Coarse location for geofenced "arrive home" trigger. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Notifications for the recap draft + bedtime reminder. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- DND access for the meeting / focus triggers. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!-- Foreground service so the sensor stream survives screen-off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />

    <application
        android:name=".DayloopApplication"
        android:label="DAYLOOP"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Dayloop"
        android:allowBackup="true"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Dayloop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".sensors.SensorForegroundService"
            android:foregroundServiceType="health"
            android:exported="false" />
    </application>
</manifest>
